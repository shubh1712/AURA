# AURA Backend Environment Configuration
PROJECT_NAME="AURA Decision-Intelligence Platform"
VERSION="0.0.1-pre-alpha"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# API Configuration
API_V1_STR=/api

# Storage Configuration ('sqlite' or 'firestore')
AURA_STORAGE_BACKEND=sqlite
FIRESTORE_DATABASE=(default)

# Execution Configuration ('local' or 'cloud_tasks')
AURA_EXECUTION_MODE=local
AURA_CLOUD_TASKS_PROJECT=
AURA_CLOUD_TASKS_LOCATION=asia-southeast1
AURA_CLOUD_TASKS_QUEUE=aura-analysis-jobs
AURA_CLOUD_TASKS_WORKER_URL=
AURA_CLOUD_TASKS_SERVICE_ACCOUNT=
AURA_OIDC_AUDIENCE=
AURA_JOB_LEASE_SECONDS=300.0
AURA_CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=600

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Cloud Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Brave Search API 
BRAVE_SEARCH_API_KEY=